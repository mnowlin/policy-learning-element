@article{dunlopIronyEpistemicLearning2017,
  title = {The {{Irony}} of {{Epistemic Learning}}: {{Epistemic Communities}}, {{Policy Learning}} and the {{Case}} of {{Europe}}’s {{Hormones Saga}}},
  shorttitle = {The {{Irony}} of {{Epistemic Learning}}},
  author = {Dunlop, Claire A},
