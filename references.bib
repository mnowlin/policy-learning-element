@article{bandelowLearningNecessaryNot2019,
  title = {Learning as a {{Necessary}} but {{Not Sufficient Condition}} for {{Major Health Policy Change}}: {{A Qualitative Comparative Analysis Combining ACF}} and {{MSF}}},
  shorttitle = {Learning as a {{Necessary}} but {{Not Sufficient Condition}} for {{Major Health Policy Change}}},
