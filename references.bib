@article{wagnerCanPolicyForums2020,
  title = {Can {{Policy Forums Overcome Echo Chamber Effects}} by {{Enabling Policy Learning}}? {{Evidence}} from the {{Irish Climate Change Policy Network}}},
  shorttitle = {Can {{Policy Forums Overcome Echo Chamber Effects}} by {{Enabling Policy Learning}}?},
  author = {Wagner, Paul M. and Ylä-Anttila, Tuomas},
  date = {2020-06},
  journaltitle = {Journal of Public Policy},
  volume = {40},
  number = {2},
