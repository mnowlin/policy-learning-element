  keywords = {topic/environment},
  file = {/Users/matthewnowlin/Zotero/storage/ZW94YPQG/McBeth et al_2023_Political ideology and nuclear energy.pdf;/Users/matthewnowlin/Zotero/storage/YLWHDAJE/ropr.html}
