@article{corbettSingularMemoryInstitutional2018,
  title = {Singular {{Memory}} or {{Institutional Memories}}? {{Toward}} a {{Dynamic Approach}}},
  shorttitle = {Singular {{Memory}} or {{Institutional Memories}}?},
  author = {Corbett, Jack and Grube, Dennis C. and Lovell, Heather and Scott, Rodney},
  date = {2018},
  journaltitle = {Governance},
  volume = {31},
  number = {3},
  pages = {555--573},
  issn = {1468-0491},
  doi = {10.1111/gove.12340},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/gove.12340},
  urldate = {2025-02-26},
  abstract = {The ability of the civil service to act as a reservoir of institutional memory is central to the pragmatic task of governing. But there is a growing body of scholarship that suggests the bureaucracy is failing at this core task. In this article, we distinguish between two different ways of thinking about institutional memory: one “static” and one “dynamic.” In the former, memory is singular and held in document form, especially by files and procedures. In the latter, memories reside with people and are thus dispersed across the array of actors that make up the differentiated polity. Drawing on four policy examples from three countries, we argue that a more dynamic understanding of the way institutions remember is both empirically salient and normatively desirable. We conclude that the current conceptualization of institutional memory needs to be recalibrated to fit the types of policy learning practices required by modern collaborative governance.},
