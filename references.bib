@article{migoneParadigmaticStabilityIdeational2024,
  title = {Paradigmatic {{Stability}}, {{Ideational Robustness}}, and {{Policy Persistence}}: {{Exploring}} the {{Impact}} of {{Policy Ideas}} on {{Policy-Making}}},
  shorttitle = {Paradigmatic {{Stability}}, {{Ideational Robustness}}, and {{Policy Persistence}}},
  author = {Migone, Andrea and Howlett, Michael and Howlett, Alexander},
  date = {2024-07-13},
  journaltitle = {Policy and Society},
