@incollection{cairneyHowShouldWe2023,
  title = {How {{Should We Compare Theories}} of the {{Policy Process}}?},
  booktitle = {Theories {{Of The Policy Process}}},
  author = {Cairney, Paul and Heikkila, Tanya},
  editor = {Weible, Christopher M.},
  date = {2023},
  edition = {5},
  pages = {291--321},
  publisher = {Routledge},
  abstract = {There are a wide range of theories, frameworks, and models (or generally “theoretical approaches”) to describe and explain policy processes. Indeed, the field of policy studies is perhaps too large and unwieldy to understand as a whole. Consequently, scholars seek guidance on which approaches might align best with the scope of their research, or whether to combine their insights – or accept some and reject others – when producing new applications. Since scholars already make these comparisons implicitly or in an ad hoc way, our first guiding question is: how can we add some rigor to this process? In this edition, our second guiding question is: how can we situate this scientific comparison in a wider normative context? In conclusion, we encourage scholars to be open to multiple and alternative criteria in their comparisons and evaluations of theories, frameworks, and models of the policy process and to make their criteria transparent. We see this as fitting with the call to explain methods, define concepts clearly, and clearly set out the causal processes, which is the conventional wisdom used to warn scholars against obfuscation, confirmation bias, and a generally defensive approach to their results.},
  pagetotal = {31},
  keywords = {topic/policy-process}
}
