@article{nowlinPolicyLearningInformation2021,
  title = {Policy {{Learning}} and {{Information Processing}}},
  author = {Nowlin, Matthew C.},
  date = {2021},
  journaltitle = {Policy Studies Journal},
  volume = {49},
