@article{malkamakiAcousticsPolicyLearning2021,
  title = {On the {{Acoustics}} of {{Policy Learning}}: {{Can Co-Participation}} in {{Policy Forums Break Up Echo Chambers}}?},
  shorttitle = {On the {{Acoustics}} of {{Policy Learning}}},
  author = {Malkamäki, Arttu and Wagner, Paul M. and Brockhaus, Maria and Toppinen, Anne and Ylä-Anttila, Tuomas},
  date = {2021},
  journaltitle = {Policy Studies Journal},
